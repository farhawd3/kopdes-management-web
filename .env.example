# Supabase BARU. Variabel ini hanya digunakan server.
HUB_SUPABASE_URL=
HUB_SUPABASE_SERVICE_KEY=
# Token acak minimal 32 karakter untuk pengaturan PIN pertama.
HUB_SETUP_TOKEN=
# Lokal: localhost. Vercel: domain HTTPS aplikasi tanpa path /pin.
# Domain deployment Vercel juga dikenali dari metadata server platform.
HUB_APP_ORIGIN=http://localhost:3000
